{
  "name": "eduagent",
  "version": "0.1.0",
  "description": "EduAgent - Study AI with Collaborative Learning",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:dev": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "frontend:dev": "cd frontend && npm run dev",
    "backend:install": "cd backend && .venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "frontend:install": "cd frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
