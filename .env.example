# Copy this file to .env and fill in your actual values before running
# docker compose up --build

# ── Required secrets ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Optional overrides ───────────────────────────────────────────────────────
# A strong random string for signing JWTs
JWT_SECRET=change_me_to_a_strong_random_secret

# Comma-separated list of allowed CORS origins
# Replace YOUR_VM_IP with your Oracle Cloud VM public IP
CORS_ALLOWED_ORIGINS=http://YOUR_VM_IP,http://YOUR_VM_IP:80
